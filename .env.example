# RecallRelay v1.0.0 — Server Environment Template
# Copy to `.env` locally and set real values.

APP_NAME=RecallRelay API
APP_VERSION=1.0.0
APP_ENV=development
DEMO_MODE=true
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_PATH=./backend/data/recall_relay.db

# Administrator API key (required for admin BFF login & admin routes)
ADMIN_API_KEY=replace-with-strong-local-admin-key

# Explicit trusted origins (never '*' with HttpOnly cookies)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SESSION_TTL_MINUTES=60
SESSION_COOKIE_SECURE=false

# Login throttling & reverse-proxy controls
LOGIN_THROTTLE_MAX=5
LOGIN_THROTTLE_WINDOW_SECONDS=900
LOGIN_THROTTLE_LOCKOUT_SECONDS=900
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=

# Agent execution & A2A transport selection (`internal_sqlite` or `band`)
AGENT_DEFAULT_TIMEOUT_SECONDS=5.0
A2A_MAX_DELEGATION_DEPTH=5
A2A_TRANSPORT=internal_sqlite
EXTERNAL_HTTP_TIMEOUT_SECONDS=10.0
EXTERNAL_MAX_RETRIES=2

# Optional openFDA API key (keyless public tier works without a key)
OPENFDA_API_KEY=

# BAND two-way shared-room A2A (standardized canonical variable names)
# Docs: https://docs.band.ai/api/introduction | Band Agent REST API
BAND_API_BASE_URL=https://app.band.ai
BAND_SENDER_AGENT_ID=
BAND_SENDER_API_KEY=
BAND_RECEIVER_AGENT_ID=
BAND_RECEIVER_API_KEY=
BAND_ROOM_ID=
BAND_POLL_ATTEMPTS=10
BAND_POLL_INTERVAL_SECONDS=0.5

# Lyzr v3 Agents API (optional; Source Analyst stays DETERMINISTIC when unset)
# Docs: https://docs.lyzr.ai/enterprise/api/agents/chat
LYZR_API_BASE_URL=https://agent-prod.studio.lyzr.ai
LYZR_API_KEY=
LYZR_AGENT_ID=

# Optional 
FINCH_MCP_URL=https://www.finchtech.ai/mcp
FINCH_API_KEY=
FINCH_CLI_PATH=
ADAL_CLI_PATH=
# Agent37 
AGENT37_API_KEY=
